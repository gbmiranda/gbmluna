{
  "manifest_version": 3,
  "name": "gbmulti language",
  "version": "0.1.0",
  "description": "Legendas traduzidas em tempo real, 100% locais, aceleradas pelo Apple Silicon.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "tabCapture",
    "offscreen",
    "scripting",
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "gbmulti language"
  }
}
